# Portal environment configuration
# Copy this file to portal/.env and adjust values for your environment.

# ── Network ───────────────────────────────────────────────────────────────
# IP address / hostname that nginx binds the HTTPS and GSA ports on.
# Use 0.0.0.0 to expose on all interfaces (e.g. when behind a load balancer).
PORTAL_HOST=127.0.0.1

# ── Feed release ──────────────────────────────────────────────────────────
# Greenbone feed release to use for vulnerability data.
FEED_RELEASE=24.10

# ── Remote scanner (distributed deployment) ───────────────────────────────
# URL of the openvasd HTTP API on the remote scanner node.
# Leave commented out (or set to http://openvasd:80) for a standalone
# all-in-one deployment using the built-in local openvasd service.
#
# To route all scanning through one or more remote scanner/compose.yaml nodes,
# set this to the address of the desired scanner and register additional
# ospd-openvas scanners via the gvmd scanner management UI or
# scripts/register-scanner.sh.
#
# Example (single remote scanner):
#OPENVASD_SERVER=http://192.168.1.50:9390
