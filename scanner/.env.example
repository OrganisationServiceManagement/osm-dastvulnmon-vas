# Scanner node environment configuration
# Copy this file to scanner/.env and adjust values for your environment.

# ── Network ───────────────────────────────────────────────────────────────
# Interface to bind the ospd-openvas OSPD port on.
# Use 0.0.0.0 to expose on all network interfaces (required for remote access
# from the central portal's gvmd).
SCANNER_LISTEN=0.0.0.0

# Host port that ospd-openvas is published on.
# The central gvmd will connect to <scanner-host>:<SCANNER_PORT>.
SCANNER_PORT=9390

# ── Feed release ──────────────────────────────────────────────────────────
# Greenbone feed release to use for vulnerability data.
FEED_RELEASE=24.10
